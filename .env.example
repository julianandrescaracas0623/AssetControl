# Copia este archivo a .env y completa los valores. .env está ignorado por git:
# nunca subas credenciales ni datos de la clínica.
#
# Si una contraseña lleva caracteres especiales (@ : / ? # %), codifícala en las
# URL (p. ej. @ -> %40); docker-compose.yml arma la URL de la API con ella tal cual.

# --- PostgreSQL local (docker compose) ---
# Rol migrador: dueño de la base y del esquema; ejecuta Alembic.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Rol de la aplicación: lo crea docker/postgres/init/01-app-role.sh con el volumen
# vacío (NOSUPERUSER, NOBYPASSRLS). Debe ser distinto de POSTGRES_USER.
# Valor sugerido: assetcontrol_app
APP_DB_USER=
APP_DB_PASSWORD=

# --- API (Flask) ---
# URL del rol de la aplicación para correr la API fuera de Docker (host localhost).
# Dentro de docker compose la API usa el host "db" y la arma el propio compose.
# Formato: postgresql+psycopg://<APP_DB_USER>:<APP_DB_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=
SECRET_KEY=
# development | test | production
ENVIRONMENT=

# --- Migraciones (Alembic) ---
# URL del rol migrador; solo la lee migrations/env.py. No es obligatoria para la API.
# Formato: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
MIGRATION_DATABASE_URL=

# --- Pruebas (pytest) sobre la base assetcontrol_test ---
# Rol de la aplicación (lo que se prueba); nunca el superusuario.
# Formato: postgresql+psycopg://<APP_DB_USER>:<APP_DB_PASSWORD>@localhost:5432/assetcontrol_test
TEST_DATABASE_URL=
# Rol migrador: crea las tablas de prueba y sus políticas.
# Formato: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/assetcontrol_test
TEST_MIGRATION_DATABASE_URL=
