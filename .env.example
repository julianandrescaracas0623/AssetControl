# Copia este archivo a .env y completa los valores. .env está ignorado por git:
# nunca subas credenciales ni datos de la clínica.
#
# Si una contraseña lleva caracteres especiales (@ : / ? # %), codifícala en las
# URL (p. ej. @ -> %40); docker-compose.yml arma la URL de la API con ella tal cual.

# --- PostgreSQL local (docker compose) ---
# Rol migrador: dueño de la base y del esquema; ejecuta Alembic.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Rol de la aplicación: lo crea docker/postgres/init/01-app-role.sh con el volumen
# vacío (NOSUPERUSER, NOBYPASSRLS). Debe ser distinto de POSTGRES_USER.
# Valor sugerido: assetcontrol_app
APP_DB_USER=
APP_DB_PASSWORD=

# --- API (Flask) ---
# URL del rol de la aplicación para correr la API fuera de Docker (host localhost).
# Dentro de docker compose la API usa el host "db" y la arma el propio compose.
# Formato: postgresql+psycopg://<APP_DB_USER>:<APP_DB_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=
SECRET_KEY=
# development (local) | staging (servidor de pruebas) | production. "test" solo lo usan
# las pruebas (pytest). staging exige lo mismo que production (TLS a la base, cookies
# Secure, ALMACEN=s3, correo solo smtp) pero no envía HSTS ni avisa por TRUSTED_PROXY_HOPS.
ENVIRONMENT=development

# --- Migraciones (Alembic) ---
# URL del rol migrador; solo la lee migrations/env.py. No es obligatoria para la API.
# Formato: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
MIGRATION_DATABASE_URL=

# --- Pruebas (pytest) sobre la base assetcontrol_test ---
# Rol de la aplicación (lo que se prueba); nunca el superusuario.
# Formato: postgresql+psycopg://<APP_DB_USER>:<APP_DB_PASSWORD>@localhost:5432/assetcontrol_test
TEST_DATABASE_URL=
# Rol migrador: crea las tablas de prueba y sus políticas.
# Formato: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/assetcontrol_test
TEST_MIGRATION_DATABASE_URL=

# --- Opcionales (spec 002, T10): vacías -> valores por defecto de backend/app/config.py ---
# Ventana y umbrales del límite de tasa (intentos por ventana).
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_LOGIN_ACCOUNT=
RATE_LIMIT_LOGIN_IP=
RATE_LIMIT_REFRESH_IP=
RATE_LIMIT_VALIDATE_IP=
RATE_LIMIT_ACCEPT_IP=
RATE_LIMIT_RECOVER_IP=
RATE_LIMIT_RECOVER_ACCOUNT=
RATE_LIMIT_RESET_IP=
# Saltos de proxy de confianza para la IP del cliente. Local: 0. Detrás del proxy de la
# plataforma (producción): normalmente 1 (docs/09-despliegue.md).
TRUSTED_PROXY_HOPS=
# gunicorn (solo imagen de producción): IP de los proxies cuyos X-Forwarded-* acepta.
# Por defecto 127.0.0.1; la IP real del cliente la decide TRUSTED_PROXY_HOPS.
# FORWARDED_ALLOW_IPS=
# Hashes Argon2 simultáneos por proceso.
ARGON2_MAX_CONCURRENCY=

# --- Fotos (spec 012) ---
# Vacío en desarrollo = carpeta local backend/.almacen (ignorada por git). Para moverla:
# ALMACEN_CARPETA=
# En producción: ALMACEN=s3 y las cinco S3_* (Supabase Storage, docs/09-despliegue.md §3).
ALMACEN=
# S3_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=
# S3_BUCKET=fotos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Correo de recuperación (spec 014) ---
# Vacío en desarrollo = recuperación de contraseña desactivada (aviso al arrancar).
# CORREO_MODO: "carpeta" (local, solo desarrollo) | "smtp". En producción solo "smtp".
CORREO_MODO=
CORREO_REMITENTE=
# Solo con CORREO_MODO=carpeta. Vacía = backend/.buzon (en docker compose, ruta del contenedor).
CORREO_CARPETA=
SMTP_HOST=
# starttls (587) | ssl (465). Obligatorio fuera de development.
SMTP_CIFRADO=
SMTP_PUERTO=
# Secretos: nunca en el repo; van juntos o ninguno.
SMTP_USUARIO=
SMTP_CLAVE=
# Base del enlace del correo. Sin "/" final. Obligatoria con CORREO_MODO.
URL_PUBLICA=

# --- Consola de plataforma (spec 017) ---
# Solo "true" la habilita. Vacío = /plataforma responde 404.
PLATAFORMA_HABILITADA=
# Redes CIDR o IP separadas por comas. Vacío = sin restricción (defensa adicional al proxy).
PLATAFORMA_REDES_PERMITIDAS=
# Límites de la consola (opcionales; por defecto en backend/app/config.py).
RATE_LIMIT_PLAT_LOGIN_ACCOUNT=
RATE_LIMIT_PLAT_LOGIN_IP=
RATE_LIMIT_PLAT_ACCION=
RATE_LIMIT_PLAT_REFRESH_IP=

# --- Supabase (producción): solo las lee `flask revisar-conexiones` ---
# La app local nunca las usa. Son conexiones Postgres (Session pooler), no la
# "Project URL" https://<ref>.supabase.co. Nunca pongas contraseñas en comentarios.
# SUPABASE_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<contraseña>@<host del pooler>:5432/postgres?sslmode=require
# SUPABASE_DATABASE_URL=postgresql+psycopg://assetcontrol_app.<ref>:<contraseña>@<host del pooler>:5432/postgres?sslmode=require

# --- Producción (spec 010b): NO van en este archivo ---
# Se guardan en la plataforma (variables secretas) y en GitHub (entorno "production").
# Lista y formato en docs/09-despliegue.md:
#   DATABASE_URL (rol de la app, pooler de Supabase en modo sesión, sslmode=require),
#   SECRET_KEY, ENVIRONMENT=production, TRUSTED_PROXY_HOPS, PORT (lo da la plataforma),
#   ALMACEN=s3, S3_ENDPOINT_URL, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY.
#   El entorno de desarrollo del servidor usa las mismas, con ENVIRONMENT=staging y su
#   propio proyecto de Supabase (docs/09-despliegue.md §6).
#   MIGRATION_DATABASE_URL solo en GitHub (migrar.yml) o en tu PC al preparar la base.

