{
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "include": ["backend"],
  "exclude": ["**/.venv", "**/__pycache__", "web"],
  "executionEnvironments": [
    { "root": "backend", "extraPaths": ["backend/tests"] }
  ],
  "typeCheckingMode": "off",
  "reportMissingImports": "error",
  "reportMissingModuleSource": "warning"
}
